{
  "name": "@enx2/opencode-eye",
  "version": "0.1.0",
  "description": "An animated eye in OpenCode Desktop that shows what the AI is doing",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "solid-js",
    "animation"
  ],
  "license": "MIT",
  "author": "TheKeyblader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheKeyblader/opencode-eye.git"
  },
  "homepage": "https://github.com/TheKeyblader/opencode-eye#readme",
  "bugs": {
    "url": "https://github.com/TheKeyblader/opencode-eye/issues"
  },
  "type": "module",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "preview": "vite --config vite.preview.config.ts",
    "icons": "bun scripts/icon-names.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.0",
    "effect": "^4.0.0",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.0",
    "@types/bun": "^1.4.4",
    "effect": "4.0.1",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14"
  }
}
